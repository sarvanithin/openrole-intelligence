# Copy to an operator-controlled environment or platform secret/config store.
# Do not commit the populated values.
JOB_INTEL_ENV=production
JOB_INTEL_DB=/data/job_intel.db
JOB_INTEL_ALLOWED_HOSTS=jobs.example.org
JOB_INTEL_PUBLIC_URL=https://jobs.example.org
JOB_INTEL_CONTACT_EMAIL=corrections@example.org
JOB_INTEL_CORS_ORIGINS=
JOB_INTEL_RATE_LIMIT=120
JOB_INTEL_SHOW_SYNTHETIC=false

# Replace with the exact trusted reverse-proxy address or provider-documented
# ingress range. Never use * if the application port can be reached directly.
FORWARDED_ALLOW_IPS=127.0.0.1
HEALTHCHECK_HOST=jobs.example.org
HOST_PORT=8000

# The scheduler polls for due work every minute, then drains all currently due
# sources in bounded batches. Individual reviewed sources default to a 60-minute
# refresh interval.
SCHEDULER_POLL_SECONDS=60
SCHEDULER_CONCURRENCY=16
SCHEDULER_BATCH_SIZE=100

# Continuous acquisition runs separately from hourly job sync. It checkpoints
# exact-CIK website acquisition, verified-domain source discovery, and probes
# only primary-provenance candidates whose vendor policy was explicitly reviewed.
# Keep one instance; a separate file lock rejects duplicates.
ACQUISITION_CADENCE_SECONDS=86400
ACQUISITION_POLL_SECONDS=60
ACQUISITION_BATCH_SIZE=50
ACQUISITION_LEASE_SECONDS=300
ACQUISITION_MAX_BATCHES=200
ACQUISITION_SCHEDULER_ACTOR=continuous-acquisition-scheduler
ACQUISITION_LEASE_OWNER=continuous-acquisition-1
SOURCE_SYNC_INTERVAL_MINUTES=60

# Comma-separated KIND=URL entries. Leave empty to keep all discovered candidates
# queued for operator review. Setting this is an explicit vendor-policy decision.
ATS_POLICY_URLS=
ATS_POLICY_APPROVED_AT=

# Contactable identities for operator-triggered public-data acquisition jobs.
WIKIMEDIA_USER_AGENT=
SEC_USER_AGENT=
